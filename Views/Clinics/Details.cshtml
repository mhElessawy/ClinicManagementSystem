@model ClinicManagementSystem.Models.ClinicDetails
@{
    ViewData["Title"] = Model.Clinic.Name;
}
<div dir="ltr">
    <a asp-action="Index">Back to Clinics</a>
    <h2 class="mt-3">@Model.Clinic.Name <small class="text-muted">@Model.Clinic.Code</small></h2>
    <p>@Model.Clinic.Address | @Model.Clinic.Phone | @Model.Clinic.Email</p>
    <form asp-action="ToggleActive" asp-route-id="@Model.Clinic.Id" method="post" class="mb-4">
        <span>Status: @(Model.Clinic.Active ? "Active" : "Disabled")</span>
        <button class="btn btn-sm btn-outline-warning" type="submit">@(Model.Clinic.Active ? "Disable Clinic Access" : "Enable Clinic Access")</button>
    </form>
    <h3>Management Accounts (@Model.Managers.Count)</h3>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Phone</th><th>Active</th></tr></thead>
            <tbody>
                @foreach (var user in Model.Managers)
                {
                    <tr><td>@user.UserFullName</td><td>@user.UserName</td><td>@user.Role?.RoleName</td><td>@user.UserTel</td><td>@user.Active</td></tr>
                }
            </tbody>
        </table>
    </div>
    <h3>Doctors and Specialties (@Model.Doctors.Count)</h3>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>Doctor</th><th>Specialty</th><th>Username</th><th>Phone</th><th>Email</th><th>Active</th></tr></thead>
            <tbody>
                @foreach (var doctor in Model.Doctors)
                {
                    <tr><td>@doctor.DoctorName</td><td>@doctor.Specialist?.SpecialistName</td><td>@doctor.LoginUsername</td><td>@doctor.DoctorTel1</td><td>@doctor.Email</td><td>@doctor.Active</td></tr>
                }
            </tbody>
        </table>
    </div>
    <h3>Assistants (@Model.Assistants.Count)</h3>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>Name</th><th>Username</th><th>Phone</th><th>Address</th><th>Doctor</th><th>Active</th></tr></thead>
            <tbody>
                @foreach (var assistant in Model.Assistants)
                {
                    <tr><td>@assistant.AssistName</td><td>@assistant.LoginUsername</td><td>@assistant.AssistTel1</td><td>@assistant.AssistAddress</td><td>@assistant.Doctor?.DoctorName</td><td>@assistant.Active</td></tr>
                }
            </tbody>
        </table>
    </div>
    <h3>Receptionists (@Model.Receptionists.Count)</h3>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>Name</th><th>Username</th><th>Phone</th><th>Address</th><th>Doctor</th><th>Active</th></tr></thead>
            <tbody>
                @foreach (var reception in Model.Receptionists)
                {
                    <tr><td>@reception.ReceptionName</td><td>@reception.LoginUsername</td><td>@reception.ReceptionTel1</td><td>@reception.ReceptionAddress</td><td>@reception.Doctor?.DoctorName</td><td>@reception.Active</td></tr>
                }
            </tbody>
        </table>
    </div>
    <h3>Clinic Patients (@Model.Patients.Count)</h3>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>Patient</th><th>Civil ID</th><th>Phone</th><th>Doctor</th><th></th></tr></thead>
            <tbody>
                @foreach (var patient in Model.Patients)
                {
                    <tr>
                        <td>@patient.PatientName</td>
                        <td>@patient.PatientCivilID</td>
                        <td>@patient.PatientTel1</td>
                        <td>@patient.Doctor?.DoctorName</td>
                        <td><a asp-controller="Patients" asp-action="Details" asp-route-id="@patient.Id">Patient Record</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>