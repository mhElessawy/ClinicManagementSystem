@model ClinicManagementSystem.Models.ClinicDetails
@{ ViewData["Title"] = Model.Clinic.Name; }
<div dir="rtl">
    <a asp-action="Index">العودة للعيادات</a>
    <h2 class="mt-3">@Model.Clinic.Name <small class="text-muted">@Model.Clinic.Code</small></h2>
    <p>@Model.Clinic.Address | @Model.Clinic.Phone | @Model.Clinic.Email</p>
    <form asp-action="ToggleActive" asp-route-id="@Model.Clinic.Id" method="post" class="mb-4">
        <span>الحالة: @(Model.Clinic.Active ? "نشطة" : "موقوفة")</span>
        <button class="btn btn-sm btn-outline-warning" type="submit">@(Model.Clinic.Active ? "إيقاف دخول فريق العيادة" : "تفعيل العيادة")</button>
    </form>
    <h3>حسابات الإدارة (@Model.Managers.Count)</h3>
    <div class="table-responsive"><table class="table table-striped"><thead><tr><th>الاسم</th><th>اسم المستخدم</th><th>الدور</th><th>التليفون</th><th>نشط</th></tr></thead>
        <tbody>@foreach (var user in Model.Managers) {
            <tr><td>@user.UserFullName</td><td>@user.UserName</td><td>@user.Role?.RoleName</td><td>@user.UserTel</td><td>@user.Active</td></tr>
        }</tbody>
    </table></div>
    <h3>الأطباء والتخصصات (@Model.Doctors.Count)</h3>
    <div class="table-responsive"><table class="table table-striped"><thead><tr><th>الطبيب</th><th>التخصص</th><th>اسم المستخدم</th><th>التليفون</th><th>البريد</th><th>نشط</th></tr></thead>
        <tbody>@foreach (var doctor in Model.Doctors) {
            <tr><td>@doctor.DoctorName</td><td>@doctor.Specialist?.SpecialistName</td><td>@doctor.LoginUsername</td><td>@doctor.DoctorTel1</td><td>@doctor.Email</td><td>@doctor.Active</td></tr>
        }</tbody>
    </table></div>
    <h3>المساعدون (@Model.Assistants.Count)</h3>
    <div class="table-responsive"><table class="table table-striped"><thead><tr><th>الاسم</th><th>اسم المستخدم</th><th>التليفون</th><th>العنوان</th><th>الطبيب</th><th>نشط</th></tr></thead>
        <tbody>@foreach (var assistant in Model.Assistants) {
            <tr><td>@assistant.AssistName</td><td>@assistant.LoginUsername</td><td>@assistant.AssistTel1</td><td>@assistant.AssistAddress</td><td>@assistant.Doctor?.DoctorName</td><td>@assistant.Active</td></tr>
        }</tbody>
    </table></div>
    <h3>الاستقبال (@Model.Receptionists.Count)</h3>
    <div class="table-responsive"><table class="table table-striped"><thead><tr><th>الاسم</th><th>اسم المستخدم</th><th>التليفون</th><th>العنوان</th><th>الطبيب</th><th>نشط</th></tr></thead>
        <tbody>@foreach (var reception in Model.Receptionists) {
            <tr><td>@reception.ReceptionName</td><td>@reception.LoginUsername</td><td>@reception.ReceptionTel1</td><td>@reception.ReceptionAddress</td><td>@reception.Doctor?.DoctorName</td><td>@reception.Active</td></tr>
        }</tbody>
    </table></div>
    <h3>مرضى العيادة (@Model.Patients.Count)</h3>
    <div class="table-responsive"><table class="table table-striped"><thead><tr><th>المريض</th><th>الرقم المدني</th><th>التليفون</th><th>الطبيب</th><th></th></tr></thead>
        <tbody>@foreach (var patient in Model.Patients) {
            <tr><td>@patient.PatientName</td><td>@patient.PatientCivilID</td><td>@patient.PatientTel1</td><td>@patient.Doctor?.DoctorName</td>
                <td><a asp-controller="Patients" asp-action="Details" asp-route-id="@patient.Id">ملف المريض</a></td></tr>
        }</tbody>
    </table></div>
</div>
