@model IEnumerable<ClinicManagementSystem.Models.Clinic>
@{ ViewData["Title"] = "إدارة العيادات"; }
<div dir="rtl">
    <h2>العيادات المسجلة</h2>
    <p>افتح العيادة لعرض حساباتها والأطباء وتخصصاتهم والمساعدين والاستقبال والمرضى.</p>
    <div class="table-responsive"><table class="table table-striped align-middle">
        <thead><tr><th>العيادة</th><th>الكود</th><th>التليفون</th><th>البريد</th><th>الحالة</th><th></th></tr></thead>
        <tbody>@foreach (var clinic in Model) {
            <tr><td>@clinic.Name</td><td><code>@clinic.Code</code></td><td>@clinic.Phone</td><td>@clinic.Email</td><td>@(clinic.Active ? "نشطة" : "موقوفة")</td>
                <td><a asp-action="Details" asp-route-id="@clinic.Id" class="btn btn-sm btn-primary">تفاصيل العيادة</a></td></tr>
        }</tbody>
    </table></div>
    @if (!Model.Any()) { <div class="alert alert-info">لا توجد عيادات مسجلة بعد.</div> }
</div>
