@model ClinicManagementSystem.Models.ClinicSubscriptionUpdate
@{
    ViewData["Title"] = "Clinic Subscription";
}
<div dir="ltr" class="col-lg-7">
    <a asp-action="Index">Back to Clinics</a>
    <h2 class="mt-3">Subscription: @ViewBag.ClinicName</h2>
    <form method="post" asp-action="Subscription" asp-route-id="@ViewContext.RouteData.Values["id"]">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-check mb-3">
            <input asp-for="Active" class="form-check-input" />
            <label asp-for="Active" class="form-check-label">Activate clinic access</label>
        </div>
        <div class="mb-3">
            <label asp-for="Period" class="form-label">Subscription period</label>
            <select asp-for="Period" class="form-select">
                <option value="1">Add 1 month</option>
                <option value="3">Add 3 months</option>
                <option value="6">Add 6 months</option>
                <option value="12">Add 12 months</option>
                <option value="custom">Set a specific end date</option>
            </select>
            <div class="form-text">Months are added to the current end date, or today if the subscription has expired.</div>
        </div>
        <div class="mb-3" id="custom-date">
            <label asp-for="SubscriptionEndsOn" class="form-label">Subscription end date</label>
            <input asp-for="SubscriptionEndsOn" type="date" class="form-control" />
            <span asp-validation-for="SubscriptionEndsOn" class="text-danger"></span>
        </div>
        <p class="text-muted">Access continues through the selected end date (Kuwait time). After expiry or deactivation, all clinic users are blocked, including existing sessions, until renewed and activated.</p>
        <button type="submit" class="btn btn-primary">Save Subscription</button>
    </form>
</div>
@section Scripts {
    <script>
        const period = document.getElementById('Period');
        const dateField = document.getElementById('SubscriptionEndsOn');
        function updateDateField() {
            const custom = period.value === 'custom';
            document.getElementById('custom-date').hidden = !custom;
            dateField.disabled = !custom;
        }
        period.addEventListener('change', updateDateField);
        updateDateField();
    </script>
}
