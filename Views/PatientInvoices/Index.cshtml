@model IEnumerable<ClinicManagementSystem.Models.PatientInvoice>
@{
    ViewData["Title"] = "Patient Invoices";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-file-invoice-dollar"></i> Patient Invoices</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> New Invoice
    </a>
</div>

<!-- Filter Form -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label fw-semibold">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Doctor</label>
                <select name="doctorId" class="form-select">
                    <option value="">-- All Doctors --</option>
                    @foreach (var item in (SelectList)ViewBag.DoctorList)
                    {
                        <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Payment Status</label>
                <select name="paymentStatus" class="form-select">
                    <option value="">-- All --</option>
                    <option value="Paid" selected="@(ViewBag.SelectedPaymentStatus == "Paid" ? "selected" : null)">Paid</option>
                    <option value="Partial" selected="@(ViewBag.SelectedPaymentStatus == "Partial" ? "selected" : null)">Partial</option>
                    <option value="Unpaid" selected="@(ViewBag.SelectedPaymentStatus == "Unpaid" ? "selected" : null)">Unpaid</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-times"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-3">
    <div class="col-md-4">
        <div class="card border-primary text-center">
            <div class="card-body py-2">
                <div class="text-muted small">Total Invoiced</div>
                <div class="fw-bold text-primary fs-5">@ViewBag.TotalAmount.ToString("N3")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-success text-center">
            <div class="card-body py-2">
                <div class="text-muted small">Total Paid</div>
                <div class="fw-bold text-success fs-5">@ViewBag.TotalPaid.ToString("N3")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-danger text-center">
            <div class="card-body py-2">
                <div class="text-muted small">Total Remaining</div>
                <div class="fw-bold text-danger fs-5">@ViewBag.TotalRemaining.ToString("N3")</div>
            </div>
        </div>
    </div>
</div>

<!-- Invoices Table -->
@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No invoices found.
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Invoice #</th>
                            <th>Date</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Paid</th>
                            <th class="text-end">Remaining</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model)
                        {
                            <tr>
                                <td><strong>@invoice.InvoiceNumber</strong></td>
                                <td>@invoice.InvoiceDate.ToString("dd/MM/yyyy")</td>
                                <td>@invoice.Patient?.PatientName</td>
                                <td>@invoice.Doctor?.DoctorName</td>
                                <td class="text-end">@invoice.NetAmount.ToString("N3")</td>
                                <td class="text-end text-success">@invoice.PaidAmount.ToString("N3")</td>
                                <td class="text-end text-danger">@invoice.RemainingAmount.ToString("N3")</td>
                                <td class="text-center">
                                    @if (invoice.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (invoice.PaymentStatus == "Partial")
                                    {
                                        <span class="badge bg-warning text-dark">Partial</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Unpaid</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-info" title="Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Print" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-secondary" title="Print" target="_blank">
                                        <i class="fas fa-print"></i>
                                    </a>
                                    @if (invoice.RemainingAmount > 0)
                                    {
                                        <a asp-action="Details" asp-route-id="@invoice.Id" class="btn btn-sm btn-success" title="Add Payment - Remaining: @invoice.RemainingAmount.ToString("N3")">
                                            <i class="fas fa-money-bill-wave"></i>
                                        </a>
                                    }
                                    <a asp-action="Edit" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="DoctorIncome" class="btn btn-outline-primary">
        <i class="fas fa-chart-bar"></i> Doctor Income Report
    </a>
</div>
