@model IEnumerable<ClinicManagementSystem.Controllers.DoctorIncomeViewModel>
@{
    ViewData["Title"] = "Doctor Income Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-chart-bar"></i> Doctor Income Report</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-file-invoice-dollar"></i> Invoices
    </a>
</div>

<!-- Filter -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Doctor</label>
                <select name="doctorId" class="form-select">
                    <option value="">-- All Doctors --</option>
                    @foreach (var item in (SelectList)ViewBag.DoctorList)
                    {
                        <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Show Report
                </button>
                <a asp-action="DoctorIncome" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-times"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No data found for the selected period.
    </div>
}
else
{
    <!-- Summary Bar -->
    <div class="row mb-3">
        <div class="col-md-3">
            <div class="card border-info text-center">
                <div class="card-body py-2">
                    <div class="text-muted small">Doctors</div>
                    <div class="fw-bold text-info fs-5">@Model.Count()</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-primary text-center">
                <div class="card-body py-2">
                    <div class="text-muted small">Total Invoices</div>
                    <div class="fw-bold text-primary fs-5">@Model.Sum(r => r.InvoiceCount)</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success text-center">
                <div class="card-body py-2">
                    <div class="text-muted small">Total Collected</div>
                    <div class="fw-bold text-success fs-5">@Model.Sum(r => r.TotalPaid).ToString("N3")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-danger text-center">
                <div class="card-body py-2">
                    <div class="text-muted small">Total Remaining</div>
                    <div class="fw-bold text-danger fs-5">@Model.Sum(r => r.TotalRemaining).ToString("N3")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Income Table -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Doctor</th>
                            <th class="text-center">Invoices</th>
                            <th class="text-end">Total Invoiced</th>
                            <th class="text-end">Collected</th>
                            <th class="text-end">Remaining</th>
                            <th class="text-end">Collection %</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{int rowNum = 1; var grandTotal = Model.Sum(r => r.TotalAmount);}
                        @foreach (var row in Model)
                        {
                            var pct = row.TotalAmount > 0 ? (row.TotalPaid / row.TotalAmount * 100) : 0;
                            <tr>
                                <td>@rowNum++</td>
                                <td><strong>@row.DoctorName</strong></td>
                                <td class="text-center">
                                    <span class="badge bg-primary rounded-pill">@row.InvoiceCount</span>
                                </td>
                                <td class="text-end">@row.TotalAmount.ToString("N3")</td>
                                <td class="text-end text-success fw-bold">@row.TotalPaid.ToString("N3")</td>
                                <td class="text-end @(row.TotalRemaining > 0 ? "text-danger" : "text-success")">
                                    @row.TotalRemaining.ToString("N3")
                                </td>
                                <td class="text-end">
                                    <div class="d-flex align-items-center justify-content-end gap-2">
                                        <div class="progress" style="width:70px; height:12px;">
                                            <div class="progress-bar @(pct >= 100 ? "bg-success" : pct >= 50 ? "bg-warning" : "bg-danger")"
                                                 style="width:@pct.ToString("F0")%"></div>
                                        </div>
                                        <span class="small">@pct.ToString("F0")%</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Index" asp-route-doctorId="@row.DoctorId"
                                       asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate"
                                       class="btn btn-sm btn-outline-primary" title="View Invoices">
                                        <i class="fas fa-list"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-secondary fw-bold">
                        <tr>
                            <td colspan="2">TOTAL</td>
                            <td class="text-center">@Model.Sum(r => r.InvoiceCount)</td>
                            <td class="text-end">@Model.Sum(r => r.TotalAmount).ToString("N3")</td>
                            <td class="text-end text-success">@Model.Sum(r => r.TotalPaid).ToString("N3")</td>
                            <td class="text-end text-danger">@Model.Sum(r => r.TotalRemaining).ToString("N3")</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}
