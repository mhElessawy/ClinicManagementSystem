@model ClinicManagementSystem.Models.PatientInvoice
@{
    ViewData["Title"] = "Invoice Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-file-invoice-dollar"></i> Invoice Details</h2>
    <div class="d-flex gap-2">
        <a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-outline-secondary" target="_blank">
            <i class="fas fa-print"></i> Print
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">
            <i class="fas fa-edit"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <!-- Invoice Header Info -->
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <i class="fas fa-info-circle"></i> Invoice Information
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless table-sm mb-0">
                            <tr>
                                <td class="text-muted" style="width:40%">Invoice #:</td>
                                <td><strong>@Model.InvoiceNumber</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Date:</td>
                                <td>@Model.InvoiceDate.ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Patient:</td>
                                <td><strong>@Model.Patient?.PatientName</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Doctor:</td>
                                <td>@Model.Doctor?.DoctorName</td>
                            </tr>
                            @if (Model.Appointment != null)
                            {
                                <tr>
                                    <td class="text-muted">Appointment:</td>
                                    <td>@Model.Appointment.AppointmentDate.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless table-sm mb-0">
                            <tr>
                                <td class="text-muted" style="width:40%">Status:</td>
                                <td>
                                    @if (Model.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success fs-6">Paid</span>
                                    }
                                    else if (Model.PaymentStatus == "Partial")
                                    {
                                        <span class="badge bg-warning text-dark fs-6">Partial</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger fs-6">Unpaid</span>
                                    }
                                </td>
                            </tr>
                            @if (!string.IsNullOrEmpty(Model.PaymentMethod))
                            {
                                <tr>
                                    <td class="text-muted">Method:</td>
                                    <td>@Model.PaymentMethod</td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <tr>
                                    <td class="text-muted">Notes:</td>
                                    <td>@Model.Notes</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Services Table -->
        <div class="card mb-3">
            <div class="card-header bg-secondary text-white">
                <i class="fas fa-list"></i> Services
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Service</th>
                                <th>Description</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int rowNum = 1;}
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@rowNum++</td>
                                    <td><strong>@item.ServiceName</strong></td>
                                    <td class="text-muted small">@item.Description</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.UnitPrice.ToString("N3")</td>
                                    <td class="text-end fw-bold">@item.TotalPrice.ToString("N3")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Summary -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-success text-white">
                <i class="fas fa-calculator"></i> Summary
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <td>Subtotal:</td>
                        <td class="text-end fw-bold">@Model.TotalAmount.ToString("N3")</td>
                    </tr>
                    @if (Model.Discount > 0)
                    {
                        <tr class="text-danger">
                            <td>Discount:</td>
                            <td class="text-end">- @Model.Discount.ToString("N3")</td>
                        </tr>
                    }
                    <tr class="table-primary">
                        <td class="fw-bold">Net Amount:</td>
                        <td class="text-end fw-bold fs-5">@Model.NetAmount.ToString("N3")</td>
                    </tr>
                    <tr class="text-success">
                        <td>Paid:</td>
                        <td class="text-end fw-bold">@Model.PaidAmount.ToString("N3")</td>
                    </tr>
                    <tr class="@(Model.RemainingAmount > 0 ? "text-danger" : "text-success")">
                        <td class="fw-bold">Remaining:</td>
                        <td class="text-end fw-bold">@Model.RemainingAmount.ToString("N3")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>
