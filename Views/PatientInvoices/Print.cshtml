@model ClinicManagementSystem.Models.PatientInvoice
@{
    ViewData["Title"] = "Print Invoice";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice - @Model.InvoiceNumber</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
        }

        .invoice-header {
            border-bottom: 3px solid #0d6efd;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .clinic-name {
            color: #0d6efd;
            font-size: 24px;
            font-weight: bold;
        }

        .invoice-title {
            color: #333;
            font-size: 18px;
        }

        .info-box {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            padding: 12px;
            margin-bottom: 15px;
        }

        .totals-table td {
            padding: 6px 10px;
        }

        .total-row {
            background: #0d6efd;
            color: white;
            font-weight: bold;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 13px;
        }

        .status-paid {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-partial {
            background: #fff3cd;
            color: #664d03;
        }

        .status-unpaid {
            background: #f8d7da;
            color: #842029;
        }

        .footer-line {
            border-top: 1px solid #dee2e6;
            margin-top: 30px;
            padding-top: 10px;
            font-size: 12px;
            color: #6c757d;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                margin: 0;
            }
        }
    </style>
</head>
<body>

    <div class="container" style="max-width:750px; margin:30px auto;">

        <!-- Print Button -->
        <div class="no-print mb-3 d-flex gap-2">
            <button onclick="window.print()" class="btn btn-primary">
                <i class="fas fa-print"></i> Print
            </button>
            <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-outline-secondary">Back</a>
        </div>

        <!-- Invoice Header -->
        <div class="invoice-header d-flex justify-content-between align-items-start">
            <div>
                <div class="clinic-name">Clinic Management System</div>
                <div class="text-muted">Medical Invoice</div>
            </div>
            <div class="text-end">
                <div class="invoice-title">INVOICE</div>
                <div class="fw-bold text-primary fs-5">#@Model.InvoiceNumber</div>
                <div class="text-muted">Date: @Model.InvoiceDate.ToString("dd/MM/yyyy")</div>
            </div>
        </div>

        <!-- Patient & Doctor Info -->
        <div class="row mb-3">
            <div class="col-6">
                <div class="info-box">
                    <div class="fw-bold text-muted small mb-1">PATIENT</div>
                    <div class="fw-bold">@Model.Patient?.PatientName</div>
                    @if (!string.IsNullOrEmpty(Model.Patient?.PatientCivilID))
                    {
                        <div class="text-muted small">ID: @Model.Patient.PatientCivilID</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Patient?.PatientTel1))
                    {
                        <div class="text-muted small">Tel: @Model.Patient.PatientTel1</div>
                    }
                </div>
            </div>
            <div class="col-6">
                <div class="info-box">
                    <div class="fw-bold text-muted small mb-1">DOCTOR</div>
                    <div class="fw-bold">@Model.Doctor?.DoctorName</div>
                    @if (!string.IsNullOrEmpty(Model.Doctor?.DoctorTitle))
                    {
                        <div class="text-muted small">@Model.Doctor.DoctorTitle</div>
                    }
                    @if (Model.Doctor?.Specialist != null)
                    {
                        <div class="text-muted small">@Model.Doctor.Specialist.SpecialistName</div>
                    }
                </div>
            </div>
        </div>

        <!-- Services Table -->
        <table class="table table-bordered mb-3">
            <thead style="background:#0d6efd; color:white;">
                <tr>
                    <th>#</th>
                    <th>Service</th>
                    <th>Description</th>
                    <th class="text-center" style="width:60px">Qty</th>
                    <th class="text-end" style="width:110px">Unit Price</th>
                    <th class="text-end" style="width:110px">Total</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNum = 1;
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@rowNum++</td>
                        <td><strong>@item.ServiceName</strong></td>
                        <td class="text-muted small">@item.Description</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@item.UnitPrice.ToString("N3")</td>
                        <td class="text-end fw-bold">@item.TotalPrice.ToString("N3")</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Totals -->
        <div class="d-flex justify-content-end">
            <table class="totals-table" style="min-width:280px;">
                <tr>
                    <td>Subtotal:</td>
                    <td class="text-end fw-bold">@Model.TotalAmount.ToString("N3")</td>
                </tr>
                @if (Model.Discount > 0)
                {
                    <tr class="text-danger">
                        <td>Discount:</td>
                        <td class="text-end">- @Model.Discount.ToString("N3")</td>
                    </tr>
                }
                <tr class="total-row">
                    <td style="padding:8px 10px;">NET AMOUNT:</td>
                    <td class="text-end" style="padding:8px 10px; font-size:16px;">@Model.NetAmount.ToString("N3")</td>
                </tr>
                <tr class="text-success">
                    <td>Amount Paid:</td>
                    <td class="text-end fw-bold">@Model.PaidAmount.ToString("N3")</td>
                </tr>
                <tr class="@(Model.RemainingAmount > 0 ? "text-danger" : "text-success")">
                    <td class="fw-bold">Balance Due:</td>
                    <td class="text-end fw-bold">@Model.RemainingAmount.ToString("N3")</td>
                </tr>
            </table>
        </div>

        <!-- Status & Notes -->
        <div class="d-flex justify-content-between align-items-start mt-3">
            <div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="info-box" style="max-width:350px;">
                        <div class="fw-bold text-muted small mb-1">NOTES</div>
                        <div>@Model.Notes</div>
                    </div>
                }
            </div>
            <div class="text-end">
                @if (Model.PaymentStatus == "Paid")
                {
                    <span class="status-badge status-paid">PAID</span>
                }
                else if (Model.PaymentStatus == "Partial")
                {
                    <span class="status-badge status-partial">PARTIALLY PAID</span>
                }
                else
                {
                    <span class="status-badge status-unpaid">UNPAID</span>
                }
                @if (!string.IsNullOrEmpty(Model.PaymentMethod))
                {
                    <div class="text-muted small mt-1">Payment via @Model.PaymentMethod</div>
                }
            </div>
        </div>

        <div class="footer-line text-center">
            <span>Thank you for your visit.</span>
            <span class="ms-3">Generated: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
    </div>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</body>
</html>