@model IEnumerable<ClinicManagementSystem.Models.DoctorGroup>
@{
    ViewData["Title"] = "Doctor Groups";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-users-medical"></i> Doctor Groups</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Create New Group
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Group Name</th>
                    <th>Description</th>
                    <th>Members</th>
                    <th>Doctors</th>
                    <th>Active</th>
                    <th>Created Date</th>
                    <th style="width: 200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.GroupName</strong></td>
                        <td>@(item.Description ?? "-")</td>
                        <td><span class="badge bg-info">@item.Members.Count</span></td>
                        <td>
                            @foreach (var member in item.Members.Take(3))
                            {
                                <span class="badge bg-secondary me-1">@member.Doctor?.DoctorName</span>
                            }
                            @if (item.Members.Count > 3)
                            {
                                <span class="badge bg-warning text-dark">+@(item.Members.Count - 3) more</span>
                            }
                        </td>
                        <td>
                            @if (item.Active)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Details">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-4">
                <i class="fas fa-users fa-3x mb-3"></i>
                <p>No doctor groups created yet.</p>
            </div>
        }
    </div>
</div>
