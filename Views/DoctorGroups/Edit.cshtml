@model ClinicManagementSystem.Models.DoctorGroup
@{
    ViewData["Title"] = "Edit Doctor Group";
    var doctors = ViewBag.Doctors as List<ClinicManagementSystem.Models.DoctorInfo>;
    var selectedDoctorIds = ViewBag.SelectedDoctorIds as List<int> ?? new List<int>();
}

<h2><i class="fas fa-edit"></i> Edit Doctor Group</h2>

<div class="card shadow-sm mt-3">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedDate" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="GroupName" class="form-label"></label>
                    <input asp-for="GroupName" class="form-control" />
                    <span asp-validation-for="GroupName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Active" class="form-label"></label>
                    <div class="form-check form-switch mt-2">
                        <input asp-for="Active" class="form-check-input" />
                        <label asp-for="Active" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label"><i class="fas fa-user-md"></i> Select Doctors</label>
                <div class="border rounded p-3" style="max-height: 300px; overflow-y: auto;">
                    @if (doctors != null && doctors.Any())
                    {
                        @foreach (var doctor in doctors)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="SelectedDoctorIds"
                                       value="@doctor.Id" id="doctor_@doctor.Id"
                                       @(selectedDoctorIds.Contains(doctor.Id) ? "checked" : "") />
                                <label class="form-check-label" for="doctor_@doctor.Id">
                                    <strong>@doctor.DoctorName</strong>
                                    @if (!string.IsNullOrEmpty(doctor.DoctorTitle))
                                    {
                                        <small class="text-muted">- @doctor.DoctorTitle</small>
                                    }
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No active doctors found.</p>
                    }
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>