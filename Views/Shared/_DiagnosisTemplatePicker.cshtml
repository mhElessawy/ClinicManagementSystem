<div class="border rounded p-3 mb-3 bg-light" id="diagnosis-template-picker" data-url="@Url.Action("Templates", "PatientDiagnoses")">
    <h6>Diagnosis Checklist</h6>
    <p class="small text-muted">Tick the words or phrases to add them to Diagnosis Details. Untick to remove them. You can also write additional notes below.</p>
    <div id="diagnosis-template-options" aria-busy="true"></div>
    <div id="diagnosis-template-status" class="form-text" role="status">Loading diagnosis options...</div>
</div>
<script src="~/js/diagnosis-templates.js" asp-append-version="true" defer></script>
