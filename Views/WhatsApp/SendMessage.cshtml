@{
    ViewData["Title"] = "Send a WhatsApp Message";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-success text-white">
                <h3 class="mb-0">
                    <i class="fab fa-whatsapp"></i> Send a WhatsApp Message
                </h3>
            </div>
            <div class="card-body p-4">
                <p class="text-muted mb-4">
                    <i class="fas fa-info-circle"></i> Enter the phone number and message you want to send via WhatsApp
                </p>

                <form id="whatsappForm">
                    <div class="mb-4">
                        <label for="phoneNumber" class="form-label">
                            <i class="fas fa-phone"></i> Phone Number
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-mobile-alt"></i>
                            </span>
                            <input type="text"
                                   class="form-control form-control-lg"
                                   id="phoneNumber"
                                   placeholder="Example: 201234567890 (country code and number, without +)"
                                   required
                                   dir="ltr">
                        </div>
                        <small class="form-text text-muted">
                            <i class="fas fa-lightbulb"></i> Include the country code without a + sign (example: 201234567890 for Egypt)
                        </small>
                    </div>

                    <div class="mb-4">
                        <label for="message" class="form-label">
                            <i class="fas fa-comment-dots"></i> Message
                        </label>
                        <textarea class="form-control form-control-lg"
                                  id="message"
                                  rows="5"
                                  placeholder="Type your message here..."
                                  required></textarea>
                        <small class="form-text text-muted">
                            <i class="fas fa-info-circle"></i> You can write your message in any language
                        </small>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fab fa-whatsapp"></i> Send via WhatsApp
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back
                        </a>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light">
                <div class="alert alert-info mb-0" role="alert">
                    <i class="fas fa-info-circle"></i>
                    <strong>Important:</strong> WhatsApp Web will open with your message ready. Press <kbd>Enter</kbd> or click Send to deliver your message.
                </div>
            </div>
        </div>

        <!-- Instructions Card -->
        <div class="card mt-4 border-info">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">
                    <i class="fas fa-question-circle"></i> How do I use this page?
                </h5>
            </div>
            <div class="card-body">
                <ol class="mb-0">
                    <li class="mb-2">
                        <strong>Enter the phone number:</strong> Include the country code without a + sign (example: 201234567890)
                    </li>
                    <li class="mb-2">
                        <strong>Write your message:</strong> Enter the message you want to send
                    </li>
                    <li class="mb-2">
                        <strong>Click Send:</strong> WhatsApp Web will open in a new window
                    </li>
                    <li class="mb-2">
                        <strong>Send the message:</strong> Press <kbd>Enter</kbd> or click Send in WhatsApp to deliver the message
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('whatsappForm').addEventListener('submit', function(e) {
            e.preventDefault();

            var phoneNumber = document.getElementById('phoneNumber').value.trim();
            var message = document.getElementById('message').value.trim();

            // Validate phone number
            if (!phoneNumber) {
                alert('Please enter a phone number');
                return;
            }

            // Remove any non-numeric characters
            phoneNumber = phoneNumber.replace(/\D/g, '');

            if (phoneNumber.length < 10) {
                alert('Invalid phone number. Include the country code and the full phone number');
                return;
            }

            if (!message) {
                alert('Please enter a message');
                return;
            }

            // Show loading message
            var submitBtn = document.querySelector('button[type="submit"]');
            var originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Opening WhatsApp...';
            submitBtn.disabled = true;

            // Encode the message for URL
            var encodedMessage = encodeURIComponent(message);

            // Create WhatsApp Web URL
            var whatsappUrl = 'https://web.whatsapp.com/send?phone=' + phoneNumber + '&text=' + encodedMessage;

            // Open WhatsApp Web in new window
            var whatsappWindow = window.open(whatsappUrl, '_blank', 'width=1000,height=700');

            // Show success message
            setTimeout(function() {
                submitBtn.innerHTML = '<i class="fas fa-check"></i> WhatsApp opened!';
                submitBtn.classList.remove('btn-success');
                submitBtn.classList.add('btn-primary');

                // Show instruction alert
                alert('WhatsApp Web opened in a new window!\n\nPress Enter or click Send in WhatsApp to deliver your message.');

                // Reset button after 3 seconds
                setTimeout(function() {
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('btn-primary');
                    submitBtn.classList.add('btn-success');
                }, 3000);
            }, 1000);
        });
    </script>
}

<style>
    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header {
        border: none;
        padding: 1.5rem;
    }

    .form-control:focus {
        border-color: #25D366;
        box-shadow: 0 0 0 0.2rem rgba(37, 211, 102, 0.25);
    }

    .btn-success {
        background-color: #25D366;
        border-color: #25D366;
    }

        .btn-success:hover {
            background-color: #128C7E;
            border-color: #128C7E;
        }

    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
    }

    .form-control {
        border-left: none;
    }

    .shadow-lg {
        box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
    }

    kbd {
        background-color: #333;
        color: #fff;
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 0.9em;
        font-weight: bold;
    }

    .alert-info {
        background-color: #d1ecf1;
        border-color: #bee5eb;
        color: #0c5460;
    }
</style>