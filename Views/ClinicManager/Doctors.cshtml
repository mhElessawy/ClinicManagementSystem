@model IEnumerable<ClinicManagementSystem.Models.DoctorInfo>
@{
    ViewData["Title"] = "Group Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-stethoscope text-primary"></i> Group Doctors</h2>
    <a asp-action="AddDoctor" class="btn btn-primary">
        <i class="fas fa-user-plus"></i> Add Doctor
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No doctors in your group yet. <a asp-action="AddDoctor">Add the first doctor</a>.
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Doctor</th>
                            <th>Specialty</th>
                            <th>Contact</th>
                            <th>Subscription</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doctor in Model)
                        {
                            var activeSub = doctor.Subscriptions?.FirstOrDefault(s => s.IsCurrentlyValid);
                            <tr>
                                <td>
                                    <div class="fw-semibold">@doctor.DoctorTitle @doctor.DoctorName</div>
                                    @if (!string.IsNullOrEmpty(doctor.Email))
                                    {
                                        <small class="text-muted">@doctor.Email</small>
                                    }
                                </td>
                                <td>
                                    @if (doctor.Specialist != null)
                                    {
                                        <span class="badge bg-secondary">@doctor.Specialist.SpecialistName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@doctor.DoctorTel1</td>
                                <td>
                                    @if (activeSub != null)
                                    {
                                        <span class="text-success">
                                            <i class="fas fa-check-circle"></i>
                                            Expires @activeSub.EndDate.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">
                                            <i class="fas fa-times-circle"></i> No active subscription
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (doctor.Active)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="EditDoctor" asp-route-id="@doctor.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}