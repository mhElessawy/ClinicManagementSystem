@model ClinicManagementSystem.Models.DoctorAssist
@{
    ViewData["Title"] = "Delete Assistant";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Assistants" class="btn btn-outline-secondary me-3">
        <i class="fas fa-arrow-left"></i>
    </a>
    <h2 class="mb-0"><i class="fas fa-trash text-danger"></i> Delete Assistant</h2>
</div>

<div class="card shadow-sm border-0 border-danger">
    <div class="card-body">
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle"></i>
            Are you sure you want to delete this assistant? This action cannot be undone.
        </div>
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.AssistName</dd>
            <dt class="col-sm-3">Doctor</dt>
            <dd class="col-sm-9">@Model.Doctor?.DoctorName</dd>
            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@(Model.AssistTel1 ?? "-")</dd>
        </dl>
        <form asp-action="DeleteAssistant" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Yes, Delete
                </button>
                <a asp-action="Assistants" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
