@model ClinicManagementSystem.Models.DoctorInfo

@{
    ViewData["Title"] = "Update Doctor Information";
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card">
            <div class="card-header bg-warning text-white">
                <h4 class="mb-0"><i class="fas fa-edit"></i> @ViewData["Title"]</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="RegDate" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DoctorName" class="form-label"><span class="text-danger">*</span></label>
                                <input asp-for="DoctorName" class="form-control" required />
                                <span asp-validation-for="DoctorName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DoctorTitle" class="form-label"></label>
                                <input asp-for="DoctorTitle" class="form-control" />
                                <span asp-validation-for="DoctorTitle" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DoctorCivilId" class="form-label"><span class="text-danger">*</span></label>
                                <input asp-for="DoctorCivilId" class="form-control" required />
                                <span asp-validation-for="DoctorCivilId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Gender" class="form-label"></label>
                                <select asp-for="Gender" class="form-control">
                                    <option value="">-- Gender --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DoctorTel1" class="form-label"><span class="text-danger">*</span></label>
                                <input asp-for="DoctorTel1" class="form-control" required />
                                <span asp-validation-for="DoctorTel1" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DoctorTel2" class="form-label"></label>
                                <input asp-for="DoctorTel2" class="form-control" />
                                <span asp-validation-for="DoctorTel2" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DoctorAddress" class="form-label"></label>
                                <textarea asp-for="DoctorAddress" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="DoctorAddress" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"><span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="doctor@example.com" required />
                                </div>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Department <span class="text-danger">*</span></label>
                                <select id="DepartmentId" name="DepartmentId" class="form-control" required>
                                    <option value="">-- Select Department --</option>
                                    @foreach (var dept in (SelectList)ViewBag.DepartmentId)
                                    {
                                        if (dept.Selected)
                                        {
                                            <option value="@dept.Value" selected>@dept.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@dept.Value">@dept.Text</option>
                                        }
                                    }
                                </select>
                                <small class="text-muted">Select department to filter specialists</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="SpecialistId" class="form-label"><span class="text-danger">*</span></label>
                                <select asp-for="SpecialistId" id="SpecialistId" class="form-control" required>
                                    <option value="">-- Select Department First --</option>
                                </select>
                                <span asp-validation-for="SpecialistId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="UserId" class="form-label"></label>
                                <select asp-for="UserId" asp-items="ViewBag.UserId" class="form-control">
                                    <option value="">-- Select User --</option>
                                </select>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DoctorDetails" class="form-label"></label>
                        <textarea asp-for="DoctorDetails" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="DoctorDetails" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Change Doctor Photo</label>
                                <input type="file" name="DoctorPictureFile" class="form-control" accept="image/*" />
                                <small class="text-muted">اترك فارغاً للإبقاء على الصورة الحالية</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Active" class="form-label"></label>
                                <div class="form-check form-switch">
                                    <input asp-for="Active" class="form-check-input" type="checkbox" />
                                    <label class="form-check-label" asp-for="Active"></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h5 class="mb-3"><i class="fas fa-lock"></i> Login Credentials</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LoginUsername" class="form-label"></label>
                                <input asp-for="LoginUsername" class="form-control" autocomplete="off" />
                                <span asp-validation-for="LoginUsername" class="text-danger"></span>
                                <small class="text-muted">اسم المستخدم لتسجيل الدخول</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="CanLogin" class="form-label"></label>
                                <div class="form-check form-switch">
                                    <input asp-for="CanLogin" class="form-check-input" type="checkbox" />
                                    <label class="form-check-label" asp-for="CanLogin"></label>
                                </div>
                                <small class="text-muted">السماح للدكتور بتسجيل الدخول</small>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="LoginPassword" class="form-label"></label>
                        <input asp-for="LoginPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="LoginPassword" class="text-danger"></span>
                        @if (ViewBag.CurrentHasPassword != null && ViewBag.CurrentHasPassword)
                        {
                            <small class="text-muted">
                                <i class="fas fa-info-circle"></i> اترك فارغاً للإبقاء على كلمة المرور الحالية، أو أدخل كلمة مرور جديدة للتغيير
                            </small>
                        }
                        else
                        {
                            <small class="text-muted">أدخل كلمة مرور جديدة (اختياري)</small>
                        }
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save"></i> Save
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Return to list
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // All specialists data for client-side filtering
        var allSpecialists = @Html.Raw(ViewBag.SpecialistsJson);
        var selectedSpecialistId = @(Model.SpecialistId.HasValue ? Model.SpecialistId.Value.ToString() : "null");

        document.addEventListener('DOMContentLoaded', function() {
            var departmentSelect = document.getElementById('DepartmentId');
            var specialistSelect = document.getElementById('SpecialistId');

            // Function to populate specialists based on department
            function populateSpecialists(departmentId, selectedId) {
                // Clear current options
                specialistSelect.innerHTML = '';

                if (!departmentId) {
                    specialistSelect.innerHTML = '<option value="">-- Select Department First --</option>';
                    return;
                }

                // Add default option
                specialistSelect.innerHTML = '<option value="">-- Select Specialist --</option>';

                // Filter and add specialists for selected department
                var filteredSpecialists = allSpecialists.filter(function(s) {
                    return s.departmentId === parseInt(departmentId);
                });

                filteredSpecialists.forEach(function(specialist) {
                    var option = document.createElement('option');
                    option.value = specialist.id;
                    option.textContent = specialist.name;
                    if (selectedId && specialist.id === selectedId) {
                        option.selected = true;
                    }
                    specialistSelect.appendChild(option);
                });
            }

            // Filter specialists when department changes
            departmentSelect.addEventListener('change', function() {
                populateSpecialists(this.value, null);
            });

            // On page load, populate specialists for the selected department
            var selectedDeptId = departmentSelect.value;
            if (selectedDeptId) {
                populateSpecialists(selectedDeptId, selectedSpecialistId);
            }
        });
    </script>
}
