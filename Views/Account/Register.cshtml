@model ClinicManagementSystem.Models.DoctorInfo

@{
    ViewData["Title"] = "Doctor Registration";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clinic Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 0;
        }

        .register-container {
            max-width: 800px;
            width: 100%;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            text-align: center;
            padding: 30px;
            border-radius: 15px 15px 0 0 !important;
        }

            .card-header i {
                font-size: 50px;
                margin-bottom: 15px;
            }

        .btn-register {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px;
            font-size: 18px;
        }

            .btn-register:hover {
                background: linear-gradient(135deg, #5a6fd6 0%, #6a4190 100%);
            }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-user-md"></i>
                <h3 class="mb-0">Doctor Registration</h3>
                <p class="mb-0 mt-2">Create your account</p>
            </div>
            <div class="card-body p-4">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                    </div>
                }

                <form asp-action="Register" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <h5 class="mb-3 text-primary"><i class="fas fa-user"></i> Personal Information</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DoctorName" class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="DoctorName" class="form-control" placeholder="Dr. John Smith" />
                            <span asp-validation-for="DoctorName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DoctorTitle" class="form-label">Title</label>
                            <input asp-for="DoctorTitle" class="form-control" placeholder="e.g., Consultant, Specialist" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DoctorCivilId" class="form-label">Civil ID</label>
                            <input asp-for="DoctorCivilId" class="form-control" placeholder="Civil ID Number" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Gender" class="form-label">Gender</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h5 class="mb-3 text-primary"><i class="fas fa-stethoscope"></i> Specialty Information</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Department <span class="text-danger">*</span></label>
                            <select id="DepartmentId" name="DepartmentId" class="form-select">
                                <option value="">-- Select Department --</option>
                                @foreach (var dept in (SelectList)ViewBag.DepartmentId)
                                {
                                    if (dept.Selected)
                                    {
                                        <option value="@dept.Value" selected>@dept.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@dept.Value">@dept.Text</option>
                                    }
                                }
                            </select>
                            <small class="text-muted">Select department first to filter specialists</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SpecialistId" class="form-label">Specialist <span class="text-danger">*</span></label>
                            <select asp-for="SpecialistId" id="SpecialistId" class="form-select">
                                <option value="">-- Select Department First --</option>
                            </select>
                            <span asp-validation-for="SpecialistId" class="text-danger"></span>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h5 class="mb-3 text-primary"><i class="fas fa-phone"></i> Contact Information</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DoctorTel1" class="form-label">Phone 1</label>
                            <input asp-for="DoctorTel1" class="form-control" placeholder="Primary phone number" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DoctorTel2" class="form-label">Phone 2</label>
                            <input asp-for="DoctorTel2" class="form-control" placeholder="Secondary phone number" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DoctorAddress" class="form-label">Address</label>
                        <textarea asp-for="DoctorAddress" class="form-control" rows="2" placeholder="Your address"></textarea>
                    </div>

                    <hr class="my-4" />
                    <h5 class="mb-3 text-primary"><i class="fas fa-lock"></i> Login Credentials</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="LoginUsername" class="form-label">Username <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input asp-for="LoginUsername" class="form-control" placeholder="e.g., dr.smith" />
                            </div>
                            <span asp-validation-for="LoginUsername" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LoginPassword" class="form-label">Password <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input asp-for="LoginPassword" type="password" class="form-control" placeholder="Minimum 6 characters" />
                            </div>
                            <span asp-validation-for="LoginPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h5 class="mb-3 text-primary"><i class="fas fa-image"></i> Profile Picture</h5>
                    <div class="mb-3">
                        <label class="form-label">Doctor Picture</label>
                        <input type="file" class="form-control" name="DoctorPictureFile" accept="image/*" />
                        <small class="text-muted">JPG, PNG, GIF - Max 2MB (will be resized automatically)</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DoctorDetails" class="form-label">About You</label>
                        <textarea asp-for="DoctorDetails" class="form-control" rows="3" placeholder="Brief description about yourself and your experience"></textarea>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-register">
                            <i class="fas fa-user-plus"></i> Register
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <span>Already have an account?</span>
                        <a asp-action="Login" class="text-decoration-none">Login here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // All specialists data for client-side filtering
        var allSpecialists = @Html.Raw(ViewBag.SpecialistsJson);

        document.addEventListener('DOMContentLoaded', function() {
            var departmentSelect = document.getElementById('DepartmentId');
            var specialistSelect = document.getElementById('SpecialistId');

            // Filter specialists when department changes
            departmentSelect.addEventListener('change', function() {
                var selectedDeptId = parseInt(this.value);

                // Clear current options
                specialistSelect.innerHTML = '';

                if (!selectedDeptId) {
                    specialistSelect.innerHTML = '<option value="">-- Select Department First --</option>';
                    return;
                }

                // Add default option
                specialistSelect.innerHTML = '<option value="">-- Select Specialist --</option>';

                // Filter and add specialists for selected department
                var filteredSpecialists = allSpecialists.filter(function(s) {
                    return s.departmentId === selectedDeptId;
                });

                filteredSpecialists.forEach(function(specialist) {
                    var option = document.createElement('option');
                    option.value = specialist.id;
                    option.textContent = specialist.name;
                    specialistSelect.appendChild(option);
                });
            });
        });
    </script>
</body>
</html>