@model ClinicManagementSystem.Models.DoctorInfo

@{
    ViewData["Title"] = "Doctor Registration";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clinic Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 0;
        }

        .register-container {
            max-width: 800px;
            width: 100%;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            text-align: center;
            padding: 30px;
            border-radius: 15px 15px 0 0 !important;
        }

            .card-header i {
                font-size: 50px;
                margin-bottom: 15px;
            }

        .btn-register {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px;
            font-size: 18px;
        }

            .btn-register:hover {
                background: linear-gradient(135deg, #5a6fd6 0%, #6a4190 100%);
            }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-user-md"></i>
                <h3 class="mb-0">Doctor Registration</h3>
                <p class="mb-0 mt-2">Create your account</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <h5 class="mb-3 text-primary"><i class="fas fa-user"></i> Personal Information</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DoctorName" class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="DoctorName" class="form-control" placeholder="Dr. John Smith" />
                            <span asp-validation-for="DoctorName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DoctorCivilId" class="form-label">Civil ID <span class="text-danger">*</span></label>
                            <input asp-for="DoctorCivilId" class="form-control" />
                            <span asp-validation-for="DoctorCivilId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="doctor@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DoctorTel1" class="form-label">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="DoctorTel1" class="form-control" placeholder="+1234567890" />
                            <span asp-validation-for="DoctorTel1" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Gender" class="form-label">Gender</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- Select --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h5 class="mb-3 text-primary"><i class="fas fa-stethoscope"></i> Specialty</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Department <span class="text-danger">*</span></label>
                            <select id="DepartmentId" name="DepartmentId" class="form-select">
                                <option value="">-- Select Department --</option>
                                @foreach (var dept in (SelectList)ViewBag.DepartmentId)
                                {
                                    <option value="@dept.Value">@dept.Text</option>
                                }
                            </select>
                            <small class="text-muted">Select department first</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SpecialistId" class="form-label">Specialist <span class="text-danger">*</span></label>
                            <select asp-for="SpecialistId" id="SpecialistId" class="form-select">
                                <option value="">-- Select Department First --</option>
                            </select>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h5 class="mb-3 text-primary"><i class="fas fa-lock"></i> Login Credentials</h5>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="LoginUsername" class="form-label">Username <span class="text-danger">*</span></label>
                            <input asp-for="LoginUsername" class="form-control" />
                            <span asp-validation-for="LoginUsername" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="LoginPassword" class="form-label">Password <span class="text-danger">*</span></label>
                            <input asp-for="LoginPassword" type="password" class="form-control" />
                            <span asp-validation-for="LoginPassword" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Confirm Password <span class="text-danger">*</span></label>
                            <input type="password" name="ConfirmPassword" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Profile Picture</label>
                        <input type="file" class="form-control" name="DoctorPictureFile" accept="image/*" />
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-register">
                            <i class="fas fa-user-plus"></i> Register
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <a asp-action="Login">Already have an account? Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        var allSpecialists = @Html.Raw(ViewBag.SpecialistsJson);

        document.addEventListener('DOMContentLoaded', function() {
            var departmentSelect = document.getElementById('DepartmentId');
            var specialistSelect = document.getElementById('SpecialistId');

            departmentSelect.addEventListener('change', function() {
                var selectedDeptId = parseInt(this.value);
                specialistSelect.innerHTML = '';

                if (!selectedDeptId) {
                    specialistSelect.innerHTML = '<option value="">-- Select Department First --</option>';
                    return;
                }

                specialistSelect.innerHTML = '<option value="">-- Select Specialist --</option>';

                var filtered = allSpecialists.filter(function(s) {
                    return s.departmentId === selectedDeptId;
                });

                filtered.forEach(function(s) {
                    var option = document.createElement('option');
                    option.value = s.id;
                    option.textContent = s.name;
                    specialistSelect.appendChild(option);
                });
            });
        });
    </script>
</body>
</html>
